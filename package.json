{
  "name": "rwp2",
  "version": "2026.07.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "RWP2 — Federated Workbench: VSCode-style desktop workbench for Revenue caseworkers",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "test:contracts": "vitest run --root libs/contracts",
    "test:desktop": "vitest run --root apps/desktop",
    "test:pure": "vitest run libs/contracts apps/desktop",
    "release": "nx release --projects=contracts,sdk,sdk-testing,ui"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "devDependencies": {
    "@nx/angular": "latest",
    "@nx/esbuild": "latest",
    "@nx/eslint": "latest",
    "@nx/eslint-plugin": "latest",
    "@nx/playwright": "latest",
    "@nx/vite": "latest",
    "@playwright/test": "latest",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "nx": "latest",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
