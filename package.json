{
  "name": "rwp2",
  "version": "2026.07.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "RWP2 — Federated Workbench: VSCode-style desktop workbench for Revenue caseworkers",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "test:contracts": "vitest run --root libs/contracts",
    "test:desktop": "vitest run --root apps/desktop",
    "test:pure": "vitest run libs/contracts apps/desktop",
    "release": "nx release --projects=contracts,sdk,sdk-testing,ui"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@nx/angular": "latest",
    "@nx/esbuild": "latest",
    "@nx/eslint": "latest",
    "@nx/eslint-plugin": "latest",
    "@nx/playwright": "latest",
    "@nx/vite": "latest",
    "@playwright/test": "latest",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "nx": "latest",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@primeng/themes": "^21.0.0",
    "primeng": "^21.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zod": "^3.24.0",
    "zone.js": "~0.15.0"
  }
}
