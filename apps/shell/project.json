{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shell/src",
  "prefix": "rwp",
  "tags": ["scope:shell"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/shell",
        "index": "apps/shell/src/index.html",
        "browser": "apps/shell/src/main.ts",
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": [],
        "styles": ["apps/shell/src/styles.css"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "buildTarget": "shell:build",
        "port": 4200,
        "proxyConfig": "apps/shell/proxy.conf.js"
      },
      "configurations": {
        "production": { "buildTarget": "shell:build:production" },
        "development": { "buildTarget": "shell:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": { "config": "apps/shell/vite.config.ts" }
    }
  }
}
