{
  "name": "content-<%= name %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/content-<%= name %>/src",
  "tags": ["scope:content"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/content-<%= name %>",
        "index": "apps/content-<%= name %>/src/index.html",
        "browser": "apps/content-<%= name %>/src/main.ts",
        "tsConfig": "apps/content-<%= name %>/tsconfig.app.json",
        "assets": [
          { "glob": "**/*", "input": "apps/content-<%= name %>/public" }
        ],
        "styles": ["apps/content-<%= name %>/src/styles.css"]
      },
      "configurations": {
        "production": { "outputHashing": "all" },
        "development": { "optimization": false, "sourceMap": true }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "buildTarget": "content-<%= name %>:build",
        "port": <%= port %>,
        "proxyConfig": "apps/content-<%= name %>/proxy.conf.js"
      },
      "configurations": {
        "development": { "buildTarget": "content-<%= name %>:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": { "config": "apps/content-<%= name %>/vite.config.ts" }
    }
  }
}
